# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
JWT_SECRET=

# Session
SESSION_DRIVER=cookie

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=coffee_life

# CORS
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Mail (Resend)
MAIL_MAILER=resend
MAIL_FROM_NAME=Your name
MAIL_FROM_ADDRESS=app@yourdomain.com
RESEND_API_KEY=

